+  align-self: center;
+}
+
+.landlord-button {
+  margin-top: 24px;
+}
+
+.landlord-steps {
+  display: grid;
+  gap: 14px;
+
+  margin: 0;
+  padding: 0;
+
+  list-style: none;
+}
+
+.landlord-steps li {
+  display: flex;
+  align-items: flex-start;
+  gap: 15px;
+
+  padding: 17px;
+
+  border: 1px solid #e2e8f0;
+  border-radius: 12px;
+
+  background: #ffffff;
+
+  transition:
+    transform 0.18s ease,
+    border-color 0.18s ease,
+    box-shadow 0.18s ease;
+}
+
+.landlord-steps li:hover {
+  transform: translateX(3px);
+
+  border-color: #bfdbfe;
+
+  box-shadow: 0 8px 20px rgba(15, 23, 42, 0.055);
+}
+
+.landlord-number {
+  display: grid;
+  place-items: center;
+
+  width: 35px;
+  height: 35px;
+
+  flex: 0 0 35px;
+
+  border-radius: 9px;
+
+  background: #eff6ff;
+  color: #2563eb;
+
+  font-size: 0.75rem;
+  font-weight: 800;
+}
+
+.landlord-step-content {
+  min-width: 0;
+}
+
+.landlord-step-title {
+  display: block;
+
+  color: #94a3b8;
+
+  font-size: 0.7rem;
+  font-weight: 750;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+}
+
+.landlord-steps p {
+  margin: 4px 0 0;
+
+  color: #475569;
+
+  font-size: 0.92rem;
+  line-height: 1.65;
+}
+
+/* ========================================
+   Closing CTA
+======================================== */
+
+.closing {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 28px;
+
+  margin-top: 64px;
+  padding-top: 30px;
+
+  border-top: 1px solid #e2e8f0;
+}
+
+.closing-copy {
+  display: flex;
+  align-items: center;
+  gap: 14px;
+}
+
+.closing-icon {
+  display: grid;
+  place-items: center;
+
+  width: 44px;
+  height: 44px;
+
+  flex: 0 0 44px;
+
+  border-radius: 11px;
+
+  background: #eff6ff;
+  color: #2563eb;
+}
+
+.closing-icon svg {
+  width: 22px;
+  height: 22px;
+}
+
+.closing h2 {
+  margin: 0;
+
+  color: #0f172a;
+
+  font-size: 1.35rem;
+  font-weight: 750;
+}
+
+.closing p {
+  margin: 5px 0 0;
+
+  color: #64748b;
+
+  font-size: 0.92rem;
+}
+
+/* ========================================
+   Animations
+======================================== */
+
+@keyframes hero-enter {
+  from {
+    opacity: 0;
+    transform: translateY(12px);
+  }
+
+  to {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+
+@keyframes decoration-enter {
+  from {
+    opacity: 0;
+    transform: translateY(14px) scale(0.98);
+  }
+
+  to {
+    opacity: 1;
+    transform: translateY(0) scale(1);
+  }
+}
+
+@keyframes card-enter {
+  from {
+    opacity: 0;
+    transform: translateY(12px);
+  }
+
+  to {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+
+/* ========================================
+   Tablet
+======================================== */
+
+@media (max-width: 1000px) {
+  .hero-inner {
+    gap: 35px;
+  }
+
+  .hero-decoration {
+    flex-basis: 250px;
+    width: 250px;
+    transform: scale(0.9);
+    transform-origin: right center;
+  }
+
+  .steps {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+
+  .step-connector {
+    display: none;
+  }
+}
+
+/* ========================================
+   Mobile
+======================================== */
+
+@media (max-width: 760px) {
+  .hero {
+    padding: 58px 0 64px;
+  }
+
+  .hero-inner {
+    display: block;
+  }
+
+  .hero-decoration {
+    display: none;
+  }
+
+  .hero-actions {
+    align-items: flex-start;
+    flex-direction: column;
+    gap: 16px;
+  }
+
+  .hero-button {
+    width: 100%;
+  }
+
+  .steps {
+    grid-template-columns: 1fr;
+  }
+
+  .step-card {
+    min-height: auto;
+    gap: 20px;
+  }
+
+  .landlord-section {
+    grid-template-columns: 1fr;
+
+    gap: 30px;
+
+    margin-top: 56px;
+  }
+
+  .landlord-button {
+    width: 100%;
+  }
+
+  .closing {
+    align-items: stretch;
+    flex-direction: column;
+  }
+
+  .closing .btn {
+    width: 100%;
+  }
+}
+
+/* ========================================
+   Small Mobile
+======================================== */
+
+@media (max-width: 480px) {
+  .content {
+    padding-bottom: 56px;
+  }
+
+  .landlord-section {
+    padding: 23px;
+    border-radius: 14px;
+  }
+
+  .closing-copy {
+    align-items: flex-start;
+  }
+
+  .closing-icon {
+    width: 40px;
+    height: 40px;
+    flex-basis: 40px;
+  }
+}
+
+/* ========================================
+   Reduced Motion
+======================================== */
+
+@media (prefers-reduced-motion: reduce) {
+  .hero-content,
+  .hero-decoration,
+  .step-card {
+    animation: none;
+  }
+
+  .step-card,
+  .landlord-steps li,
+  .hero-button svg,
+  .landlord-button svg,
+  .closing .btn svg,
+  .text-link {
+    transition: none;
+  }
+
+  .step-card:hover,
+  .landlord-steps li:hover {
+    transform: none;
+  }
+}
 </style>
